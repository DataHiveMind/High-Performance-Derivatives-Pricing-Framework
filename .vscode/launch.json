{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Debug C++ Tests",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tests/test_models",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build All"
        },
        {
            "name": "Python: Debug C++ Bindings",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/python/research/surface_fit.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/build/bindings"
            },
            "justMyCode": false 
        }
    ]
}